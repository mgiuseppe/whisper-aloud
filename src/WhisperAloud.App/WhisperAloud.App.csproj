<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WhisperAloud.Core\WhisperAloud.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WhisperAloud</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icona dell'exe (Esplora file) e delle finestre (barra delle applicazioni). -->
    <EmbeddedResource Include="app.ico" LogicalName="WhisperAloud.app.ico" />
  </ItemGroup>

  <!-- Pubblicazione: i pacchetti di Whisper.net portano le librerie native di ogni sistema; nell'exe per Windows x64
       restano solo quelle per win-x64 (CPU) e vulkan/win-x64 (GPU). -->
  <Target Name="TrimForeignRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_PublishPath Include="@(ResolvedFileToPublish)" Path="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/'))" />
      <_ForeignRuntime Include="@(_PublishPath)"
                       Condition="$([System.String]::Copy('%(_PublishPath.Path)').StartsWith('runtimes/'))
                                  And !$([System.String]::Copy('%(_PublishPath.Path)').StartsWith('runtimes/win-x64/'))
                                  And !$([System.String]::Copy('%(_PublishPath.Path)').StartsWith('runtimes/vulkan/win-x64/'))" />
      <ResolvedFileToPublish Remove="@(_ForeignRuntime)" />
    </ItemGroup>
  </Target>

</Project>